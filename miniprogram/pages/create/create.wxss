/* 文件路径：miniprogram/pages/create/create.wxss */
/* 发起投票页样式（微信原生表单风格） */

.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx 24rpx 60rpx;
}

/* 分组卡片 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}
.required { color: #fa5151; }

/* 头像昵称 */
.identity-row { display: flex; align-items: center; }
.avatar-btn {
  /* !important 用于压过微信 button 组件的默认宽度，否则按钮被撑成宽椭圆 */
  width: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  height: 112rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 36rpx 0 0;
  overflow: hidden;
  background: #f0f0f0;
  flex-shrink: 0;
  box-sizing: border-box;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 112rpx; height: 112rpx; }
.avatar-placeholder {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
}
.nickname-input {
  flex: 1;
  height: 88rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

/* 问题输入 */
.question-input {
  width: 100%;
  min-height: 120rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 问题配图 */
.image-add {
  margin-top: 16rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.image-add-hover { background: #f9f9f9; }
.image-add-icon {
  font-size: 48rpx;
  color: #bbb;
  line-height: 1;
}
.image-add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.image-preview-wrap {
  margin-top: 16rpx;
  position: relative;
  width: 320rpx;
  height: 320rpx;
}
.image-preview {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
}
.image-del {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
  z-index: 2;
}

/* 选项 */
.option-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.option-input {
  flex: 1;
  height: 80rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.option-del {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fbeaea;
  color: #fa5151;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.option-del-disabled { opacity: 0.3; }
.option-add {
  text-align: center;
  color: #07c160;
  font-size: 28rpx;
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid #f0f0f0;
}
.option-add-disabled { color: #999; }

/* 时间选择 */
.picker-row { display: flex; }
.picker-value {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  margin-right: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}
.picker-row picker:last-child .picker-value { margin-right: 0; }
.picker-row picker { flex: 1; }
.picker-placeholder { color: #999; }

/* 提交按钮 */
.submit-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  margin-top: 16rpx;
}
.submit-btn[disabled] { background: #95d5b2; color: #fff; }
.submit-hover { opacity: 0.85; }
