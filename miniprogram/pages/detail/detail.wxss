/* 文件路径：miniprogram/pages/detail/detail.wxss */
/* 投票详情页样式（微信原生风格） */

.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx 24rpx 60rpx;
}

/* 骨架屏 */
.skeleton-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.skeleton-line { background: #eee; border-radius: 8rpx; margin-bottom: 20rpx; }
.skeleton-title { width: 70%; height: 36rpx; }
.skeleton-sub { width: 45%; height: 26rpx; }

/* 空状态 / 错误状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e9e9e9;
  color: #999;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-text { color: #999; font-size: 28rpx; margin-bottom: 32rpx; }
.btn-retry {
  font-size: 28rpx;
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

/* 发起人信息 */
.creator-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.avatar-default {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.creator-info { flex: 1; }
.creator-name { font-size: 30rpx; color: #1a1a1a; font-weight: 500; }
.creator-time { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.badge-active { color: #07c160; background: rgba(7, 193, 96, 0.1); }
.badge-ended { color: #999; background: #f0f0f0; }
.question {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
/* 问题配图：宽度撑满卡片，高度按原图比例（widthFix），点击看大图 */
.question-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #f6f6f6;
}
.deadline { font-size: 26rpx; color: #999; }

/* 提示语 */
.tip { font-size: 26rpx; color: #999; margin-bottom: 24rpx; }

/* 可投票选项 */
.option-item {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.option-clickable { display: flex; align-items: center; }
.option-hover { background: #f0faf4; border-color: #07c160; }
.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.option-text { font-size: 30rpx; color: #1a1a1a; flex: 1; }

/* 结果展示 */
.option-result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.my-choice { color: #07c160; font-size: 24rpx; }
.option-num { font-size: 26rpx; color: #666; flex-shrink: 0; margin-left: 20rpx; }
.percent-track {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.percent-bar {
  height: 100%;
  background: #95d5b2;
  border-radius: 8rpx;
  transition: width 0.4s ease;
}
.percent-bar-mine { background: #07c160; }
.total {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 发起人操作 */
.action-row { display: flex; }
.action-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
  margin-right: 20rpx;
}
.action-btn:last-child { margin-right: 0; }
.action-warn { color: #e6a23c; background: rgba(230, 162, 60, 0.1); }
.action-danger { color: #fa5151; background: rgba(250, 81, 81, 0.1); }
.action-btn::after { border: none; }
.action-hint { font-size: 22rpx; color: #bbb; margin-top: 16rpx; text-align: center; }

/* 分享按钮 */
.share-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
}
.share-btn::after { border: none; }
.submit-hover { opacity: 0.85; }
