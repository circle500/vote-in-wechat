/* 文件路径：miniprogram/pages/index/index.wxss */
/* 投票列表页样式（微信原生风格） */

.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 40rpx;
}

/* 顶部 Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #e5e5e5;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-active {
  color: #07c160;
  font-weight: 500;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #07c160;
}

/* 骨架屏 */
.skeleton-wrap { padding: 24rpx; }
.skeleton-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.skeleton-line {
  background: #eee;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.skeleton-title { width: 70%; height: 36rpx; }
.skeleton-sub { width: 40%; height: 26rpx; margin-bottom: 0; }

/* 空状态 / 错误状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e9e9e9;
  color: #999;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-text { color: #999; font-size: 28rpx; margin-bottom: 32rpx; }
.btn-retry {
  font-size: 28rpx;
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
}

/* 投票卡片 */
.vote-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 32rpx;
}
.card-hover { opacity: 0.7; }
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.badge-active { color: #07c160; background: rgba(7, 193, 96, 0.1); }
.badge-ended { color: #999; background: #f0f0f0; }
.card-deadline { font-size: 24rpx; color: #999; }
.card-question {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-creator { display: flex; align-items: center; }
.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.avatar-default {
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.creator-name { font-size: 26rpx; color: #666; }
.card-meta { font-size: 24rpx; color: #999; }

/* 底部加载状态 */
.load-foot {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* 右下角发起按钮（抬高，为下方公告入口留出空间） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 210rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 20;
}
.fab-hover { opacity: 0.85; }

/* 更新公告入口（圆形，与上方 + 按钮同轴心对齐） */
.notice-entry {
  position: fixed;
  right: 30rpx;          /* 120rpx 宽，中心与 100rpx 宽的 + 按钮对齐 */
  bottom: 66rpx;         /* 紧邻 + 按钮下方，间距 24rpx */
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 20;
}
.notice-text {
  width: 84rpx;          /* 约容纳两字，使「更新公告」折成两行 */
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  color: #666;
}
.notice-hover { opacity: 0.7; }
