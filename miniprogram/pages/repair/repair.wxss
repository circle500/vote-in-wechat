/* 文件路径：miniprogram/pages/repair/repair.wxss */
/* 管理员修复页样式（微信原生简洁风） */

.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
}
.desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.6;
}

.state {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}

.summary {
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 8rpx 20rpx;
}

.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.item-main { display: flex; flex-direction: column; }
.item-question {
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-path {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  word-break: break-all;
}
.item-status { margin-top: 12rpx; font-size: 24rpx; }
.status-pending { color: #999; }
.status-doing { color: #1989fa; }
.status-ok { color: #07c160; }
.status-fail { color: #fa5151; }
.item-error {
  font-size: 22rpx;
  color: #fa5151;
  margin-top: 8rpx;
  word-break: break-all;
}

.repair-btn {
  margin-top: 32rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.repair-btn[disabled] { background: #9fe3bd; color: #fff; }
.btn-hover { opacity: 0.85; }

/* 离屏画布：移出可视区域，但不能用 display:none（否则取不到节点） */
.offscreen-canvas {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 300px;
  height: 300px;
}
