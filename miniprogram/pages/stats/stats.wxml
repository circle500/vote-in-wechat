<!-- 文件路径：miniprogram/pages/stats/stats.wxml -->
<!-- 数据看板页（管理员专属） -->
<view class="page">

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-card">
    <view class="skeleton-line skeleton-title"></view>
    <view class="skeleton-line skeleton-sub"></view>
    <view class="skeleton-line skeleton-sub"></view>
  </view>

  <!-- 非管理员提示 -->
  <view wx:elif="{{forbidden}}" class="empty-wrap">
    <view class="empty-icon">锁</view>
    <view class="empty-text">仅管理员可查看数据看板</view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{error}}" class="empty-wrap">
    <view class="empty-icon">!</view>
    <view class="empty-text">{{error}}</view>
    <button class="btn-retry" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:elif="{{overview}}">

    <!-- 总览卡片 -->
    <view class="overview-grid">
      <view class="ov-card">
        <view class="ov-num">{{overview.totalVotes}}</view>
        <view class="ov-label">投票总数</view>
      </view>
      <view class="ov-card">
        <view class="ov-num ov-green">{{overview.activeCount}}</view>
        <view class="ov-label">进行中</view>
      </view>
      <view class="ov-card">
        <view class="ov-num ov-gray">{{overview.expiredCount}}</view>
        <view class="ov-label">已过期</view>
      </view>
      <view class="ov-card">
        <view class="ov-num ov-blue">{{overview.totalBallots}}</view>
        <view class="ov-label">参与人次</view>
      </view>
      <view class="ov-card">
        <view class="ov-num ov-purple">{{overview.uniqueVoters}}</view>
        <view class="ov-label">独立参与人数</view>
      </view>
    </view>

    <!-- 近7天趋势 -->
    <view class="card">
      <view class="card-title">近 7 天趋势</view>
      <view class="chart">
        <view class="chart-col" wx:for="{{days}}" wx:key="label">
          <view class="chart-bars">
            <view class="bar bar-votes" style="height: {{item.votesH}}%"></view>
            <view class="bar bar-ballots" style="height: {{item.ballotsH}}%"></view>
          </view>
          <view class="chart-vals">{{item.votes}}/{{item.ballots}}</view>
          <view class="chart-label">{{item.label}}</view>
        </view>
      </view>
      <view class="legend">
        <view class="legend-item"><view class="dot dot-green"></view>发起数</view>
        <view class="legend-item"><view class="dot dot-blue"></view>参与人次</view>
        <view class="legend-hint">柱下数字：发起/参与</view>
      </view>
    </view>

    <!-- 热门投票 Top5 -->
    <view class="card">
      <view class="card-title">热门投票 Top5</view>
      <view wx:if="{{top.length === 0}}" class="empty-line">暂无数据</view>
      <view
        class="top-item"
        wx:for="{{top}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goDetail"
        hover-class="card-hover"
      >
        <view class="top-rank top-rank-{{index + 1}}">{{index + 1}}</view>
        <view class="top-body">
          <view class="top-question">{{item.question}}</view>
          <view class="top-track">
            <view class="top-bar" style="width: {{item.totalVotes / maxBallots * 100}}%"></view>
          </view>
        </view>
        <view class="top-num">{{item.totalVotes}}票</view>
      </view>
    </view>

  </block>
</view>
