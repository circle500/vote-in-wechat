/* 文件路径：miniprogram/pages/stats/stats.wxss */
/* 数据看板页样式（微信原生风格，纯 WXSS 绘制图表） */

.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx 24rpx 60rpx;
}

/* 骨架屏 */
.skeleton-card { background: #fff; border-radius: 16rpx; padding: 32rpx; }
.skeleton-line { background: #eee; border-radius: 8rpx; margin-bottom: 20rpx; }
.skeleton-title { width: 60%; height: 36rpx; }
.skeleton-sub { width: 40%; height: 26rpx; }

/* 空状态 / 无权限 / 错误 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e9e9e9;
  color: #999;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-text { color: #999; font-size: 28rpx; margin-bottom: 32rpx; }
.btn-retry {
  font-size: 28rpx;
  color: #07c160;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
}

/* 总览卡片（两列网格） */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.ov-card {
  width: 48.5%;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}
.ov-num { font-size: 48rpx; font-weight: 500; color: #1a1a1a; line-height: 1.2; }
.ov-green { color: #07c160; }
.ov-gray { color: #999; }
.ov-blue { color: #378add; }
.ov-purple { color: #7f77dd; }
.ov-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.card-hover { opacity: 0.7; }
.card-title { font-size: 30rpx; font-weight: 500; color: #1a1a1a; margin-bottom: 32rpx; }

/* 近7天柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  height: 260rpx;
}
.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.chart-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
}
.bar {
  width: 22rpx;
  border-radius: 6rpx 6rpx 0 0;
  margin: 0 4rpx;
}
.bar-votes { background: #07c160; }
.bar-ballots { background: #85b7eb; }
.chart-vals { font-size: 20rpx; color: #999; margin-top: 8rpx; }
.chart-label { font-size: 20rpx; color: #666; margin-top: 4rpx; }
.legend {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-right: 32rpx;
}
.dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 8rpx; }
.dot-green { background: #07c160; }
.dot-blue { background: #85b7eb; }
.legend-hint { font-size: 22rpx; color: #bbb; margin-left: auto; }

/* 热门投票 Top5 */
.empty-line { text-align: center; color: #999; font-size: 26rpx; padding: 40rpx 0; }
.top-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.top-item:last-child { border-bottom: none; }
.top-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #999;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.top-rank-1 { background: #fa5151; color: #fff; }
.top-rank-2 { background: #e6a23c; color: #fff; }
.top-rank-3 { background: #07c160; color: #fff; }
.top-body { flex: 1; min-width: 0; }
.top-question {
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
}
.top-track {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.top-bar { height: 100%; background: #07c160; border-radius: 6rpx; }
.top-num { font-size: 26rpx; color: #666; margin-left: 20rpx; flex-shrink: 0; }
